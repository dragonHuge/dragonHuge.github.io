": 0, "quote": false}, {"elements": [{"element_type": 0, "text_element": {"text": "进行语法信息的学习，这就是语言模型的预训练过程。", "text_style": {}}}], "indent": 0, "list_begin_index": 0, "paragraph_type": 0, "quote": false}]}, "text": "通过更大的语料库和更深的神经网络体系，\n进行语法信息的学习，这就是语言模型的预训练过程。", "text_background_color_type": 0, "text_color": "#1f2329", "text_color_type": 0, "theme_text_background_color_code": -1, "theme_text_color_code": -1, "underline": false, "vertical_align": "mid"}, "type": "text_shape", "width": 384, "x": 828.3513793945312, "y": 265.4449462890625, "z_index": 22}, {"angle": 0, "composite_shape": {"type": "round_rect"}, "height": 59, "id": "o1:226", "locked": false, "style": {"border_color": "#d4b45b", "border_color_type": 0, "border_opacity": 100, "border_style": "solid", "border_width": "narrow", "fill_color": "#fef1ce", "fill_color_type": 0, "fill_opacity": 100, "theme_border_color_code": 8, "theme_fill_color_code": 5}, "text": {"angle": 0, "font_size": 18, "font_weight": "bold", "horizontal_align": "center", "italic": false, "line_through": false, "text": "Bag-of-Words模型", "text_background_color_type": 0, "text_color": "#1f2329", "text_color_type": 0, "theme_text_background_color_code": -1, "theme_text_color_code": -1, "underline": false, "vertical_align": "mid"}, "type": "composite_shape", "width": 186.83712768554688, "x": -21.716567993164062, "y": 632.1639404296875, "z_index": 2}, {"angle": 0, "height": 69.50399780273438, "id": "a2:11", "text": {"angle": 0, "font_size": 16, "font_weight": "regular", "horizontal_align": "left", "italic": false, "line_through": false, "text": "将一个句子或文档表示为单词的集合，不考虑单词在文本中的顺序。", "text_background_color_type": 0, "text_color": "#1f2329", "text_color_type": 0, "theme_text_background_color_code": -1, "theme_text_color_code": -1, "underline": false, "vertical_align": "mid"}, "type": "text_shape", "width": 196.99998474121094, "x": 82.69265747070312, "y": 527.0903930664062, "z_index": 13}, {"angle": 0, "height": 69.50399780273438, "id": "a2:19", "lock